# Copy to .env and fill what you have. EVERYTHING is optional: with no keys the system runs on the
# free fallback stack (Google STT + Pollinations/scripted LLM + Microsoft neural voices).
# Each key you add lights up a faster/premium provider; order of use is set in the dashboard.

# --- LLM (Groq is the single biggest latency win: free key at console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENROUTER_API_KEY=

# --- Native speech-to-speech engine (uses GEMINI_API_KEY above) ---
VOICE_ENGINE=cascade                 # cascade | gemini_live  (default for phone calls; console has a switch)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Kore               # Kore, Aoede, Leda, Zephyr, Puck, Charon, Fenrir, Orus

# --- Speech-to-text ---
DEEPGRAM_API_KEY=          # nova-3, language=multi handles Hinglish code-switching
SARVAM_API_KEY=            # best for Indian languages (also used for TTS)
WHISPER_MODEL=small        # local offline fallback (CPU)

# --- Text-to-speech ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5   # set eleven_v3 for native [sighs]/[whispers] (slower)
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_HI=
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_EN=
CARTESIA_VOICE_HI=
SARVAM_SPEAKER=anushka
NVIDIA_API_KEY=            # Magpie TTS Multilingual via build.nvidia.com (pip install nvidia-riva-client)

# --- Agent ---
COMPANY_NAME=Vaani
MAX_CONCURRENT_CALLS=50

# --- Telephony (Twilio): point your number's Voice webhook at https://PUBLIC_HOST/twilio/voice ---
PUBLIC_HOST=
